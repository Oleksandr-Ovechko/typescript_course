{
  // Наследует все настройки корневого конфига и переопределяет только include.
  // Отдельный проект нужен по двум причинам:
  //   1. корневой конфиг исключает **/homework/** из общей проверки, иначе
  //      `yarn typecheck` на уроке показывал бы чужие ошибки вперемешку;
  //   2. без него редактор не отнёс бы эти файлы ни к одному проекту и проверял
  //      бы их без `strict` — то есть типы в задании 4 просто не работали бы.
  "extends": "../../../tsconfig.json",
  "include": ["./**/*.ts"],
  // Корневой конфиг исключает **/homework/** — здесь сбрасываем этот exclude,
  // иначе проект остался бы без единого файла (TS18003).
  "exclude": []
}
