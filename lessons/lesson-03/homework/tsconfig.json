{
  // Наследует все настройки корневого конфига и переопределяет только include.
  // Отдельный проект нужен по двум причинам:
  //   1. до выполнения домашка намеренно не проходит проверку — иначе `yarn typecheck`
  //      на уроке показывал бы чужие ошибки вперемешку с демонстрируемыми;
  //   2. без него редактор не отнёс бы эти файлы ни к одному проекту и проверял бы
  //      их без `strict` — то есть задание 1 (починить
  //      `explorerSpec.durationMs` без `as`) просто не работало бы.
  "extends": "../../../tsconfig.json",
  "include": ["./**/*.ts"],
  // Корневой конфиг исключает **/homework/** из общей проверки — здесь
  // сбрасываем этот exclude, иначе проект остался бы без единого файла (TS18003).
  "exclude": []
}
