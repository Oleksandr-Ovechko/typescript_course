{
  "name": "wl-ts-course",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "JS/TS course for wl-e2e team",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "typecheck:hw2": "tsc --noEmit -p lessons/lesson-02/homework",
    "typecheck:hw3": "tsc --noEmit -p lessons/lesson-03/homework",
    "typecheck:hw4": "tsc --noEmit -p lessons/lesson-04/homework",
    "typecheck:hw5": "tsc --noEmit -p lessons/lesson-05/homework",
    "typecheck:hw6": "tsc --noEmit -p lessons/lesson-06/homework",
    "typecheck:hw10": "tsc --noEmit -p lessons/lesson-10/homework",
    "typecheck:hw12": "tsc --noEmit -p lessons/lesson-12/homework",
    "typecheck:hw13": "tsc --noEmit -p lessons/lesson-13/homework",
    "typecheck:hw14": "tsc --noEmit -p lessons/lesson-14/homework",
    "typecheck:hw15": "tsc --noEmit -p lessons/lesson-15/homework",
    "typecheck:modules": "tsc -p lessons/lesson-03/examples/modules --noEmit",
    "typecheck:broken": "tsc --noEmit -p lessons/lesson-02/examples/broken"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
